+++ b/test_calc.py
@@ -1,13 +1,38 @@
 import datetime
+import json
+import subprocess
+import sys
 import unittest
+from pathlib import Path
 
 import calc
 
+ROOT = Path(__file__).resolve().parent
+
+
+def run_cli(*args):
+    return subprocess.run(
+        [sys.executable, str(ROOT / "cli.py"), *args],
+        capture_output=True,
+        text=True,
+    )
+
 
 class CalcTest(unittest.TestCase):
     def test_add(self):
         self.assertEqual(calc.add(2, 3), 5)
 
+    def test_version(self):
+        proc = run_cli("--version")
+        self.assertEqual(proc.returncode, 0)
+        self.assertEqual(proc.stdout, (ROOT / "VERSION").read_text().strip() + "\n")
+        self.assertEqual(proc.stderr, "")
+
+    def test_add_json(self):
+        proc = run_cli("add", "2", "3", "--json")
+        self.assertEqual(proc.returncode, 0)
+        self.assertEqual(json.loads(proc.stdout), {"result": 5.0})
+
     def test_mean(self):
         self.assertEqual(calc.mean([1, 2, 3]), 2)
 
